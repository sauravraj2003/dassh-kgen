# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://dassh:dassh_secret@postgres:5432/dassh_db

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM Providers ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

LLM_PROVIDER=auto

# ── Rate Limiting ──────────────────────────────────────────────────────────────
CHAT_RATE_LIMIT=20
GAME_RATE_LIMIT=10

# ── App ────────────────────────────────────────────────────────────────────────
# In Docker, frontend is served by nginx on port 5174 → nginx proxies to backend
CORS_ORIGIN=http://localhost:5174,http://localhost:8080,http://localhost:3000
ENV=production
