# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon key (from Project Settings → API)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase JWT secret (from Project Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ── LLM Providers ─────────────────────────────────────────────────────────────
# PRIMARY: Groq — free tier, extremely fast inference
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use (free options):
#   llama-3.3-70b-versatile  ← best quality, 128k context (recommended)
#   llama3-70b-8192          ← also great, 8k context
#   mixtral-8x7b-32768       ← 32k context
#   gemma2-9b-it             ← fast, lightweight
GROQ_MODEL=llama-3.3-70b-versatile

# FALLBACK: Google Gemini — free tier via Google AI Studio
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: OpenAI (paid) — only used if both groq and gemini fail
OPENAI_API_KEY=your_openai_api_key_here

# Provider order: "auto" = groq → gemini → openai
# You can also set: "groq", "gemini", or "openai" to force a single provider
LLM_PROVIDER=auto

# ── Rate Limiting ──────────────────────────────────────────────────────────────
CHAT_RATE_LIMIT=20
GAME_RATE_LIMIT=10

# ── App Settings ───────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
ENV=development
