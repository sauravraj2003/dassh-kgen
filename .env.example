# ── Supabase (Frontend) ────────────────────────────────────────────────────────
# Your Supabase project URL (from Project Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon key (from Project Settings → API)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Backend API ────────────────────────────────────────────────────────────────
# URL of the FastAPI backend (default for local development)
VITE_API_URL=http://localhost:8000

# NOTE: AI API keys (Gemini, OpenAI) belong in backend/.env — NOT here.
# The frontend never touches AI keys directly.